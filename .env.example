# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3307
DB_DATABASE=notification
DB_USERNAME=app
DB_PASSWORD=app_password
DB_ROOT_PASSWORD=root_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# API docs at /docs (UI) and /docs-json (OpenAPI). Defaults to false.
SWAGGER_ENABLED=true
