# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3307
DB_DATABASE=notification
DB_USERNAME=app
DB_PASSWORD=app_password
DB_ROOT_PASSWORD=root_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# API docs at /docs (UI) and /docs-json (OpenAPI). Defaults to false.
SWAGGER_ENABLED=true

# HS256 key for user JWTs (/devices, /me). At least 32 characters, e.g.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Key for /admin APIs (X-Admin-Key header). At least 32 characters.
ADMIN_API_KEY=

# Workers consume the send queues in this process. Set false for an API-only instance.
WORKERS_ENABLED=true

# Send retries: attempts per job (including the first) and the base delay of
# the exponential backoff (1x, 2x, 4x, ... with jitter).
SEND_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_MS=2000

# Sweeper: run interval, and how long a notification may stay PENDING, or
# QUEUED/RETRYING/SENDING, before its job is checked and re-added.
SWEEP_INTERVAL_MS=30000
SWEEP_PENDING_AFTER_MS=60000
SWEEP_STUCK_AFTER_MS=600000

# Providers per channel: fake records sends without calling anything,
# ses sends real email through AWS SES v2, fcm sends real web push.
EMAIL_PROVIDER=fake
PUSH_PROVIDER=fake
FAKE_PROVIDER_LATENCY_MS=0

# AWS SES (required when EMAIL_PROVIDER=ses). In the SES sandbox both the
# sender and the recipients must be verified identities, except the mailbox
# simulator (success@simulator.amazonses.com and friends).
AWS_REGION=ap-northeast-2
SES_FROM_ADDRESS=
# Configuration set whose event destination publishes to SNS_TOPIC_ARN
# (delivery, bounce, complaint, open). Optional.
SES_CONFIGURATION_SET=
# Leave both empty to use the AWS SDK's default credential chain (IAM role).
# Use an IAM user limited to ses:SendEmail.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Firebase (required when PUSH_PROVIDER=fcm). Path to the service account key
# JSON, kept outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=

# Web push demo (npm run demo:config). Firebase console > Project settings >
# General > Your apps (web app config), and Cloud Messaging > Web Push
# certificates (VAPID public key).
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_VAPID_PUBLIC_KEY=

# Browser origins allowed to call the API, comma separated. The demo page
# runs at http://localhost:8080.
CORS_ORIGINS=

# SES events through SNS (POST /webhooks/ses). Only messages from this topic
# are accepted; leave empty to reject all.
SNS_TOPIC_ARN=
