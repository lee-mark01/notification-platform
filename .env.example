# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3307
DB_DATABASE=notification
DB_USERNAME=app
DB_PASSWORD=app_password
DB_ROOT_PASSWORD=root_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# API docs at /docs (UI) and /docs-json (OpenAPI). Defaults to false.
SWAGGER_ENABLED=true

# HS256 key for user JWTs (/devices, /me). At least 32 characters, e.g.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Workers consume the send queues in this process. Set false for an API-only instance.
WORKERS_ENABLED=true

# Providers per channel: fake records sends without calling anything,
# ses sends real email through AWS SES v2.
EMAIL_PROVIDER=fake
PUSH_PROVIDER=fake
FAKE_PROVIDER_LATENCY_MS=0

# AWS SES (required when EMAIL_PROVIDER=ses). In the SES sandbox both the
# sender and the recipients must be verified identities, except the mailbox
# simulator (success@simulator.amazonses.com and friends).
AWS_REGION=ap-northeast-2
SES_FROM_ADDRESS=
# Leave both empty to use the AWS SDK's default credential chain (IAM role).
# Use an IAM user limited to ses:SendEmail.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
